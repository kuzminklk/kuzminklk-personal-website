{
  "version": 2,
  "builds": [
    {
      "src": "server/src/app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "client/dist/assets/$1"
    },
    {
      "src": "/img/(.*)",
      "dest": "client/dist/img/$1"
    },
    {
      "src": "/(.*)",
      "dest": "server/src/app.js"
    }
  ]
}